#!/usr/bin/env nix-shell
#!nix-shell -i bb -p babashka bubblewrap
;; vim: set filetype=clojure:

(ns burow
  (:require [babashka.classpath :as classpath]
            [babashka.fs :as fs]
            [babashka.process :as process]
            [clojure.string :as string]))

(def xdg-config-home
  (fs/path (or (System/getenv "XDG_CONFIG_HOME")
               (fs/path (System/getProperty "user.home") ".config"))))
(def user-config-dir (fs/path xdg-config-home "burow"))

(declare parse-arguments load-config load-config-file
         bwrap-options-with-cwd bwrap-options install-override!
         user-id required-environment canonical-path fail)

(defn main [args]
  (let [[extra-configs program] (parse-arguments args)]
    (load-config extra-configs)
    (apply process/exec "bwrap" (concat (bwrap-options-with-cwd) program))))

(defn parse-arguments [args]
  (loop [configs []
         remaining args]
    (if (and (seq remaining) (string/starts-with? (first remaining) "-"))
      (let [argument (first remaining)
            [option inline] (string/split argument #"=" 2)
            inline? (string/includes? argument "=")]
        (when-not (= option "--config")
          (fail (str "unknown option " argument)))
        (let [[value rest-args]
              (cond
                inline? [inline (rest remaining)]
                (next remaining) [(second remaining) (nnext remaining)]
                :else (fail "--config requires a path"))]
          (when (empty? value)
            (fail "--config requires a path"))
          (recur (conj configs (canonical-path value)) rest-args)))
      [configs (if (seq remaining) remaining ["bash"])])))

(defn load-config [extra-paths]
  (let [project-dir (fs/path (fs/cwd) ".burow")
        default-paths [(fs/path user-config-dir "config.clj")
                       (fs/path project-dir "config.clj")
                       (fs/path project-dir "config.local.clj")]]
    (doseq [path default-paths
            :when (fs/exists? path)]
      (load-config-file path))
    (doseq [path extra-paths]
      (when-not (fs/exists? path)
        (fail (str "config not found: " path)))
      (load-config-file path))))

(defn load-config-file [path]
  (classpath/add-classpath (str (fs/parent path)))
  (load-file (str path)))

(defn bwrap-options-with-cwd []
  (let [cwd (str (fs/cwd))]
    (into ["--chdir" cwd]
          (concat (bwrap-options) ["--bind" cwd cwd]))))

(defn bwrap-options []
  (let [cert "/etc/ssl/certs/ca-certificates.crt"
        home (System/getProperty "user.home")
        nix-conf (canonical-path "/etc/nix/nix.conf")
        dbus (str "/run/user/" (user-id) "/bus")]
    ["--unshare-all"
     "--die-with-parent"
     "--share-net"
     "--ro-bind" "/etc/passwd" "/etc/passwd"
     "--ro-bind" "/etc/resolv.conf" "/etc/resolv.conf"
     "--ro-bind" cert cert
     "--proc" "/proc"
     "--dev" "/dev"
     "--dev-bind" "/dev/kvm" "/dev/kvm"
     "--tmpfs" "/tmp"
     "--setenv" "TMPDIR" "/tmp"
     "--ro-bind" "/nix/store" "/nix/store"
     "--bind" "/nix/var/nix/daemon-socket" "/nix/var/nix/daemon-socket"
     "--ro-bind" "/nix/var/nix/profiles" "/nix/var/nix/profiles"
     "--ro-bind" nix-conf "/etc/nix/nix.conf"
     "--ro-bind" "/run/current-system/sw" "/run/current-system/sw"
     "--setenv" "NIX_REMOTE" "daemon"
     "--ro-bind" "/usr/bin/env" "/usr/bin/env"
     "--ro-bind" "/bin/sh" "/bin/sh"
     "--tmpfs" home
     "--setenv" "HOME" home
     "--setenv" "USER" (required-environment "USER")
     "--setenv" "PS1" "[burow] \\w \\$ "
     "--bind" dbus dbus
     "--setenv" "DBUS_SESSION_BUS_ADDRESS" (str "unix:path=" dbus)]))

(defmacro override [target bindings & body]
  `(install-override! (var ~target) (fn ~bindings ~@body)))

(defn install-override! [target wrapper]
  (alter-var-root
   target
   (fn [previous]
     (when-not (ifn? previous)
       (throw (IllegalArgumentException.
               (str "override target is not a function: " target))))
     (fn [& args]
       (apply wrapper previous args)))))

(defn user-id []
  (string/trim (:out (process/shell {:out :string} "id" "-u"))))

(defn required-environment [name]
  (or (System/getenv name)
      (throw (IllegalStateException.
              (str "required environment variable is not set: " name)))))

(defn canonical-path [path]
  (.getCanonicalPath (java.io.File. (str path))))

(defn fail [message]
  (binding [*out* *err*]
    (println (str "burow: " message)))
  (System/exit 1))

(main *command-line-args*)
