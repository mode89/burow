#!/usr/bin/env python3

# pylint: disable=missing-docstring

import functools
import importlib.util
import os
import shlex
import shutil
import sys
from pathlib import Path


XDG_CONFIG_HOME = Path(
    os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
USER_CONFIG_DIR = XDG_CONFIG_HOME / "burow"
USER_CACHE_DIR = Path(
    os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "burow"


def main():
    extra_configs, program = parse_arguments(sys.argv[1:])
    load_config(extra_configs)
    bwrap = ["bwrap", *bwrap_options(), *program]
    command = f"exec {shlex.join(bwrap)}"
    os.execvp("nix-shell", [
        "nix-shell",
        "--packages", *nix_shell_packages(),
        "--run", command,
    ])


def parse_arguments(args):
    """Split leading burow options from the command to run. Parsing stops at
    the first argument that is not an option, so the command keeps its own
    flags."""
    configs = []
    while args and args[0].startswith("-"):
        option, sep, inline = args[0].partition("=")
        if option != "--config":
            sys.exit(f"burow: unknown option {args[0]}")
        if sep:
            value, args = inline, args[1:]
        elif len(args) > 1:
            value, args = args[1], args[2:]
        else:
            sys.exit("burow: --config requires a path")
        if not value:
            sys.exit("burow: --config requires a path")
        configs.append(Path(value).resolve())
    return configs, list(args) or ["bash"]


def load_config(extra_paths=()):
    # Alias so config's `import burow` finds us, not a second instance.
    sys.modules.setdefault("burow", sys.modules[__name__])
    project_dir = Path.cwd() / ".burow"
    # Later wins: project dir over global, config.local.py over config.py.
    paths = [
        USER_CONFIG_DIR / "config.py",
        project_dir / "config.py",
        project_dir / "config.local.py",
    ]
    for path in paths:
        if path.exists():
            exec_config(path)
    for path in extra_paths:
        if not path.exists():
            sys.exit(f"burow: config not found: {path}")
        exec_config(path)


def exec_config(path):
    sys.path.append(str(path.parent))
    spec = importlib.util.spec_from_file_location("burow_config", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)


def bwrap_options():
    cert = "/etc/ssl/certs/ca-certificates.crt"
    home = Path.home()
    cwd = Path.cwd()
    nix_conf = os.path.realpath("/etc/nix/nix.conf")
    dbus = f"/run/user/{os.getuid()}/bus"
    return [
        "--unshare-all",
        "--die-with-parent",
        "--share-net",
        "--ro-bind", "/etc/passwd", "/etc/passwd",
        "--ro-bind", "/etc/resolv.conf", "/etc/resolv.conf",
        "--ro-bind", cert, cert,
        "--proc", "/proc",
        "--dev", "/dev",
        "--dev-bind", "/dev/kvm", "/dev/kvm",
        "--tmpfs", "/tmp",
        "--setenv", "TMPDIR", "/tmp",
        "--ro-bind", "/nix/store", "/nix/store",
        "--bind", "/nix/var/nix/daemon-socket", "/nix/var/nix/daemon-socket",
        "--ro-bind", "/nix/var/nix/profiles", "/nix/var/nix/profiles",
        "--ro-bind", nix_conf, "/etc/nix/nix.conf",
        "--ro-bind", "/run/current-system/sw", "/run/current-system/sw",
        "--setenv", "NIX_REMOTE", "daemon",
        "--ro-bind", "/usr/bin/env", "/usr/bin/env",
        "--ro-bind", "/bin/sh", "/bin/sh",
        "--tmpfs", str(home),
        "--setenv", "HOME", str(home),
        "--setenv", "USER", os.environ["USER"],
        "--setenv", "PS1", r"[burow] \w \$ ",
        "--bind", dbus, dbus,
        "--setenv", "DBUS_SESSION_BUS_ADDRESS", f"unix:path={dbus}",
        "--bind", str(cwd), str(cwd),
        "--chdir", str(cwd),
    ]


def nix_shell_packages():
    return [
        "bubblewrap",
    ]


def override(arg):
    """Replace a function, injecting the previous version as the first argument
    so overrides can chain. Used as ``@burow.override`` (replaces
    ``burow.<name>``) or ``@burow.override(target)`` (replaces
    ``target`` wherever it lives)."""
    if not callable(arg):
        raise TypeError(
            f"@burow.override expects a function; "
            f"got {type(arg).__name__}")
    home = sys.modules.get(arg.__module__)
    if home is not None and getattr(home, arg.__name__, None) is arg:
        return lambda fn: _install(home, arg.__name__, arg, fn)
    ps_module = sys.modules[__name__]
    if not hasattr(ps_module, arg.__name__):
        raise AttributeError(
            f"burow has no attribute {arg.__name__!r}; for targets "
            f"outside burow, use the explicit form: "
            f"@burow.override(<module>.{arg.__name__})")
    return _install(
        ps_module, arg.__name__, getattr(ps_module, arg.__name__), arg)


def _install(module, name, target, fn):
    """Install `fn` at `module.name`, with `target` curried as first arg."""
    @functools.wraps(fn)
    def wrapper(*args, **kwargs):
        return fn(target, *args, **kwargs)
    # Rewrite so a later @burow.override(wrapper) routes here, not to fn's
    # original module.
    wrapper.__module__ = module.__name__
    setattr(module, name, wrapper)
    return wrapper


if __name__ == "__main__":
    main()
